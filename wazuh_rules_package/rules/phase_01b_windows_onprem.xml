<!--
SIG Phase 1B: Windows on-premises endpoint monitoring, separated from the cloud/Linux baseline.
-->
<group name="sig,phase_01b,windows,onprem,authentication,">

<rule id="100300" level="5">
    <if_sid>60122</if_sid>
    <description>SIG: Windows logon failed - unknown user or invalid password.</description>
    <mitre><id>T1110</id></mitre>
    <group>sig_windows,authentication_failed,</group>
  </rule>

<rule id="100301" level="10" frequency="5" timeframe="60" ignore="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>SIG: Windows brute-force attempt - five failed logons from one source IP in 60 seconds.</description>
    <mitre><id>T1110</id></mitre>
    <group>sig_windows,bruteforce,authentication_failures,</group>
  </rule>

<rule id="100302" level="8">
    <if_sid>60115</if_sid>
    <description>SIG: Windows account locked out after repeated authentication failures.</description>
    <mitre><id>T1110</id><id>T1531</id></mitre>
    <group>sig_windows,account_lockout,</group>
  </rule>

<rule id="100303" level="8">
    <if_sid>60109</if_sid>
    <description>SIG: Windows user account created or enabled.</description>
    <mitre><id>T1136</id></mitre>
    <group>sig_windows,account_created,</group>
  </rule>

<rule id="100304" level="9">
    <if_sid>60113</if_sid>
    <description>SIG: Windows group membership changed - review for privileged access.</description>
    <mitre><id>T1098</id></mitre>
    <group>sig_windows,account_changed,privilege_escalation,</group>
  </rule>

<rule id="100305" level="8">
    <field name="win.system.eventID">^7045$</field>
    <description>SIG: Windows service installed.</description>
    <mitre><id>T1543.003</id></mitre>
    <group>sig_windows,persistence,service_install,</group>
  </rule>

<rule id="100306" level="8">
    <field name="win.system.eventID">^4698$|^4702$</field>
    <description>SIG: Windows scheduled task created or updated.</description>
    <mitre><id>T1053.005</id></mitre>
    <group>sig_windows,persistence,scheduled_task,</group>
  </rule>

<rule id="100307" level="8">
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-encodedcommand)</field>
    <description>SIG: PowerShell encoded command observed.</description>
    <mitre><id>T1059.001</id></mitre>
    <group>sig_windows,powershell,execution,</group>
  </rule>

<rule id="100308" level="10">
    <if_sid>60117</if_sid>
    <description>SIG: Windows Security audit log cleared.</description>
    <mitre><id>T1070.001</id></mitre>
    <group>sig_windows,defense_evasion,log_cleared,</group>
  </rule>

<rule id="100309" level="9">
    <field name="win.system.eventID">^1116$</field>
    <description>SIG: Microsoft Defender malware detection.</description>
    <mitre><id>T1204</id></mitre>
    <group>sig_windows,malware,defender,</group>
  </rule>

<rule id="100310" level="7">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.logonType">^2$|^10$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)^(administrator|sig-admin-01)$</field>
    <description>SIG TEMPLATE: Interactive or remote interactive login by a privileged Windows account.</description>
    <mitre><id>T1078</id></mitre>
    <group>sig_windows,privileged_account,authentication_success,</group>
  </rule>

</group>
